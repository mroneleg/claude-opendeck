      "States": [
        {
          "Image": "icons/breakdown",
          "ShowTitle": false
        }
      ],
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false,
      "PropertyInspectorPath": "pi/index.html"
    },
    {
      "UUID": "com.mroneleg.claudeusage.extrausage",
