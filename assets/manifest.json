      "States": [
        {
          "Image": "icons/usage",
          "ShowTitle": false
        }
      ],
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false,
      "PropertyInspectorPath": "pi/index.html"
    },
    {
      "UUID": "com.mroneleg.claudeusage.breakdown",
      "Name": "Usage Breakdown",
      "Tooltip": "This week's usage by surface (Claude Code, Chats, ...)",
